{
  "name": "python-camp",
  "version": "1.0.0",
  "description": "5-day gamified Python camp for kids (~age 10). Zero dependencies.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
